func t(s: String) -> String:
	var lang: String = Game.lang
	if lang == "pt" or s == "":
		return s
	var d: Dictionary = EN if lang == "en" else ES
	if d.has(s):
		return d[s]
	# "Chapa maior 2" -> traduz "Chapa maior" e mantém o número
	var sp := s.rfind(" ")
	if sp > 0 and s.substr(sp + 1).is_valid_int() and d.has(s.substr(0, sp)):
		return d[s.substr(0, sp)] + s.substr(sp)
	return s
