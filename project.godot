; Engine configuration file.
config_version=5

[application]

config/name="Lanche em Pânico"
config/description="Jogo mobile 3D vertical de administração de lanchonete e montagem de hambúrgueres"
run/main_scene="res://scenes/BrandSplash.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.12, 0.08, 0.06, 1)
boot_splash/show_image=false

[autoload]

AudioManager="*res://autoload/AudioManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
Recipes="*res://autoload/Recipes.gd"
AdManager="*res://autoload/AdManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=0
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
